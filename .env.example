# Copy to .env.local (local dev) and add the same variables in Vercel → Project → Settings → Environment Variables.
# NEVER add the Supabase service-role key anywhere. LearnSignal runs everything under the signed-in user's RLS.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → Get API key. Server-only (no NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=
# A current Flash-class model id that AI Studio's free tier lists, e.g. the one shown in AI Studio's model picker.
GEMINI_MODEL=
# true / false. false = built-in practice only, assistant disabled (useful if you hit free-tier limits).
AI_ENABLED=true

# Optional: shared public demo account for judges ("Try the demo" button). Create this user yourself in Supabase Auth.
DEMO_EMAIL=
DEMO_PASSWORD=
